FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
COPY scripts/quality/check-npm-toolchain.mjs /tmp/check-npm-toolchain.mjs
RUN npm install --global npm@12.0.2 \
    && test "$(npm --version)" = "12.0.2" \
    && cd "$(npm root --global)/npm" \
    && npm pkg delete devDependencies \
    && npm install --ignore-scripts --omit=dev --no-save brace-expansion@5.0.9 ip-address@10.3.1 \
    && node /tmp/check-npm-toolchain.mjs \
    && rm /tmp/check-npm-toolchain.mjs
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/dashboard-schema/package.json packages/dashboard-schema/package.json
COPY design-system/package.json design-system/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY apps/web apps/web
COPY apps/api/internal/querycatalog/defaults apps/api/internal/querycatalog/defaults
COPY packages packages
COPY design-system design-system
RUN VITE_USE_MOCK=false npm run build --workspace @k8s-dashboard/web \
    && rm -f /src/apps/web/dist/mockServiceWorker.js

FROM nginxinc/nginx-unprivileged:1.30.4-alpine@sha256:44e36330f74d4f3a1d4e222acca9e23b401fb87811a7597024502bb759c4dd49
COPY --from=build --chown=101:101 /src/apps/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
