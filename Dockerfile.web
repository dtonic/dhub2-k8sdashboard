FROM node:22.14.0-alpine3.21@sha256:9bef0ef1e268f60627da9ba7d7605e8831d5b56ad07487d24d1aa386336d1944 AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/dashboard-schema/package.json packages/dashboard-schema/package.json
COPY design-system/package.json design-system/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
COPY apps/web apps/web
COPY apps/api/internal/querycatalog/defaults apps/api/internal/querycatalog/defaults
COPY packages packages
COPY design-system design-system
RUN VITE_USE_MOCK=false npm run build --workspace @k8s-dashboard/web \
    && rm -f /src/apps/web/dist/mockServiceWorker.js

FROM nginxinc/nginx-unprivileged:1.27.4-alpine3.21@sha256:62a904036bfc0e4a4f2b556e34cbf17bc136b47fde8cdb4628762725f48c5782
COPY --from=build --chown=101:101 /src/apps/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
