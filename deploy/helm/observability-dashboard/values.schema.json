{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "ui", "api", "clusterState", "redis", "dashboardBuilder", "networkPolicy", "telemetry"],
  "properties": {
    "environment": {"enum": ["dev", "stage", "prod"]},
    "imagePullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
    "secretRevision": {"type": "string"},
    "ui": {"$ref": "#/definitions/workload"},
    "api": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {"type": "object", "required": ["config", "existingSecret"], "properties": {
          "config": {"type": "object", "required": ["ADDR", "AUTH_MODE", "USE_DEMO_DATA"], "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "existingSecret": {"type": "object", "required": ["name", "keys"], "properties": {"name": {"type": "string"}, "keys": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}}}
        }}
      ]
    },
    "clusterState": {"type":"object","required":["mode","clusters","trustDomain","registryEndpoint","registryServerName","tls","registry","limits"],"properties":{"mode":{"enum":["direct","central"]},"clusters":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","maxLength":63,"pattern":"^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$"}},"trustDomain":{"type":"string"},"registryEndpoint":{"type":"string"},"registryServerName":{"type":"string","maxLength":253,"pattern":"^$|^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"},"tls":{"type":"object"},"registry":{"type":"object","properties":{"agentService":{"type":"object","properties":{"sourceCidrs":{"type":"array","items":{"$ref":"#/definitions/ipv4Cidr"}}}}}},"limits":{"type":"object","properties":{"ingressFrameRate":{"type":"number","minimum":1,"maximum":100000},"ingressByteRate":{"type":"number","minimum":1024,"maximum":1073741824},"ingressFrameBurst":{"type":"integer","minimum":1,"maximum":100000},"ingressByteBurst":{"type":"integer","minimum":1024,"maximum":1073741824},"staleTTL":{"type":"string","pattern":"^[1-9][0-9]*(s|m|h)$"},"heartbeatTimeout":{"type":"string","pattern":"^[1-9][0-9]*(s|m|h)$"}}}}},
    "redis": {
      "type": "object", "required": ["enabled", "image", "persistence", "resources"],
      "properties": {
        "enabled": {"type": "boolean"}, "image": {"$ref": "#/definitions/image"},
        "persistence": {"type": "object", "required": ["enabled", "size"], "properties": {"enabled": {"type": "boolean"}, "size": {"type": "string", "minLength": 1}, "storageClass": {"type": "string"}}},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "dashboardBuilder": {
      "type": "object", "required": ["enabled", "databaseURLKey", "cursorKeyKey", "maxConnections", "connectTimeout", "requireTLS", "postgresEgress"],
      "properties": {
        "enabled": {"type": "boolean"}, "databaseURLKey": {"type": "string", "minLength": 1}, "cursorKeyKey": {"type": "string", "minLength": 1},
        "maxConnections": {"type": "integer", "minimum": 1, "maximum": 32}, "connectTimeout": {"type": "string", "pattern": "^(?:[1-9]|[12][0-9]|30)s$"}, "requireTLS": {"type": "boolean"},
        "postgresEgress": {"type": "object", "required": ["cidrs", "port"], "properties": {"cidrs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/cidr"}}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"postgresEgress": {"properties": {"cidrs": {"minItems": 1}}}}}}]
    },
    "networkPolicy": {
      "type": "object", "required": ["enabled", "ingress", "dns", "kubernetesApiCidrs", "external", "internal"],
      "properties": {
        "enabled": {"const": true},
        "kubernetesApiCidrs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cidr"}},
        "external": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/destination"}},
        "internal": {"type": "array", "items": {"type": "object", "required": ["namespaceSelector", "podSelector", "port"], "properties": {"namespaceSelector": {"type": "object", "minProperties": 1}, "podSelector": {"type": "object", "minProperties": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["TCP", "UDP"]}}}},
        "ingress": {
          "type": "object", "required": ["namespaceSelector", "podSelector", "cidrs"],
          "properties": {
            "namespaceSelector": {"type": "object"}, "podSelector": {"type": "object"},
            "cidrs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}}
          },
          "anyOf": [
            {"properties": {"cidrs": {"minItems": 1}}},
            {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}
          ]
        },
        "monitoring": {
          "type": "object", "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {"enabled": {"type": "boolean"}, "namespaceSelector": {"type": "object"}, "podSelector": {"type": "object"}},
          "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}}]
        },
        "dns": {
          "type": "object", "required": ["namespaceSelector", "podSelector"],
          "properties": {"namespaceSelector": {"type": "object", "minProperties": 1}, "podSelector": {"type": "object", "minProperties": 1}}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["mode", "clusterName", "image", "collectorBuildVerified", "existingLogCollectionDisabled", "existingMetricCollectionDisabled", "existingSecret", "memoryLimiter", "agent", "gateway", "clusterCollector", "backends", "comparison"],
      "properties": {
        "mode": {"enum": ["disabled", "validate", "cutover"]},
        "clusterName": {"type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$"},
        "image": {"$ref": "#/definitions/image"},
        "collectorBuildVerified": {"type": "boolean"},
        "existingLogCollectionDisabled": {"type": "boolean"},
        "existingMetricCollectionDisabled": {"type": "boolean"},
        "existingSecret": {
          "type": "object", "required": ["name", "keys"],
          "properties": {
            "name": {"type": "string"},
            "keys": {
              "type": "object", "required": ["greptimeAuthorization", "quickwitAuthorization"],
              "properties": {"greptimeAuthorization": {"type": "string", "minLength": 1}, "quickwitAuthorization": {"type": "string", "minLength": 1}}
            }
          }
        },
        "memoryLimiter": {"type": "object", "required": ["limitMiB", "spikeLimitMiB"], "properties": {"limitMiB": {"type": "integer", "minimum": 32, "maximum": 65536}, "spikeLimitMiB": {"type": "integer", "minimum": 1, "maximum": 65535}}},
        "agent": {
          "type": "object",
          "required": ["kubeletCidrs", "resources"],
          "properties": {
            "kubeletCidrs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/cidr"}},
            "resources": {"$ref": "#/definitions/resources"}
          }
        },
        "gateway": {
          "type": "object", "required": ["replicas", "resources", "pdb"],
          "properties": {
            "replicas": {"type": "integer", "minimum": 2, "maximum": 10},
            "resources": {"$ref": "#/definitions/resources"},
            "pdb": {"type": "object", "required": ["minAvailable"], "properties": {"minAvailable": {"type": "integer", "minimum": 1}}}
          }
        },
        "clusterCollector": {
          "type": "object", "required": ["kubeStateMetrics", "resources"],
          "properties": {
            "kubeStateMetrics": {"type": "object", "required": ["endpoint", "namespaceSelector", "podSelector"], "properties": {"endpoint": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"}, "namespaceSelector": {"type": "object"}, "podSelector": {"type": "object"}}},
            "resources": {"$ref": "#/definitions/resources"}
          }
        },
        "backends": {
          "type": "object", "required": ["greptime", "quickwit", "egress"],
          "properties": {
            "greptime": {"$ref": "#/definitions/telemetryBackend"},
            "quickwit": {"allOf": [{"$ref": "#/definitions/telemetryBackend"}, {"type": "object", "required": ["index"], "properties": {"endpoint": {"pattern": "^(?:|[A-Za-z0-9.-]+:[0-9]{1,5})$"}, "index": {"const": "otel-logs-v0_7"}}}]},
            "egress": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/definitions/telemetryDestination"}}
          }
        },
        "comparison": {"$ref": "#/definitions/telemetryComparison"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"enum": ["stage", "prod"]}}},
      "then": {
        "properties": {
          "ui": {
            "properties": {
              "replicas": {"minimum": 2},
              "image": {"required": ["digest"], "properties": {"digest": {"pattern": "^sha256:[a-f0-9]{64}$"}}}
            }
          },
          "api": {
            "properties": {
              "replicas": {"minimum": 2},
              "image": {"required": ["digest"], "properties": {"digest": {"pattern": "^sha256:[a-f0-9]{64}$"}}},
              "config": {"properties": {"AUTH_MODE": {"const": "oidc"}, "USE_DEMO_DATA": {"const": "false"}}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"environment": {"const": "prod"}}},
      "then": {"properties": {"networkPolicy": {"properties": {"external": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"telemetry": {"properties": {"mode": {"const": "cutover"}}, "required": ["mode"]}}},
      "then": {"properties": {"telemetry": {"properties": {
        "clusterName": {"minLength": 1},
        "existingLogCollectionDisabled": {"const": true},
        "existingMetricCollectionDisabled": {"const": true},
        "existingSecret": {"properties": {"name": {"minLength": 1}}},
        "backends": {"properties": {
          "greptime": {"properties": {"endpoint": {"minLength": 1, "pattern": "^https?://[A-Za-z0-9.-]+:[0-9]{1,5}/v1/otlp$"}}},
          "quickwit": {"properties": {"endpoint": {"minLength": 1}}},
          "egress": {"minItems": 2, "maxItems": 2}
        }},
        "agent": {"properties": {"kubeletCidrs": {"minItems": 1}}},
        "clusterCollector": {"properties": {"kubeStateMetrics": {"properties": {"namespaceSelector": {"minProperties": 1}, "podSelector": {"minProperties": 1}}}}},
        "comparison": {"properties": {
          "recorded": {"const": true}, "evidenceId": {"minLength": 1}, "windowMinutes": {"minimum": 30},
          "baselineEvents": {"minimum": 1}, "candidateEvents": {"minimum": 1},
          "lossPermille": {"minimum": 0}, "p95LatencyMs": {"minimum": 0},
          "collectorCpuMillicores": {"minimum": 0}, "collectorMemoryMiB": {"minimum": 0},
          "egressBytesPerHour": {"minimum": 0}, "storageBytesPerDay": {"minimum": 0},
          "estimatedCostMicrosPerDay": {"minimum": 0}
        }}
      }}}}
    }
  ],
  "definitions": {
    "image": {"type": "object", "required": ["repository", "tag", "digest"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "not": {"const": "latest"}}, "digest": {"type": "string"}}},
    "resources": {"type": "object", "required": ["requests", "limits"], "properties": {"requests": {"type": "object", "required": ["cpu", "memory"]}, "limits": {"type": "object", "required": ["cpu", "memory"]}}},
    "workload": {"type": "object", "required": ["image", "replicas", "resources", "autoscaling", "pdb"], "properties": {"image": {"$ref": "#/definitions/image"}, "replicas": {"type": "integer", "minimum": 1}, "resources": {"$ref": "#/definitions/resources"}, "autoscaling": {"type": "object", "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"]}, "pdb": {"type": "object", "required": ["enabled", "minAvailable"]}}},
    "cidr": {"type": "string", "pattern": "^.+/.+$", "not": {"enum": ["0.0.0.0/0", "::/0"]}},
    "ipv4Cidr": {"type":"string","pattern":"^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/(?:[1-9]|[12][0-9]|3[0-2])$"},
    "destination": {"type": "object", "required": ["cidr", "port", "purpose"], "properties": {"cidr": {"$ref": "#/definitions/cidr"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["TCP", "UDP"]}, "purpose": {"enum": ["greptime", "quickwit", "oidc", "redis"]}}},
    "telemetryBackend": {"type": "object", "required": ["endpoint", "insecure"], "properties": {"endpoint": {"type": "string", "maxLength": 512}, "database": {"type": "string", "minLength": 1, "maxLength": 128}, "insecure": {"type": "boolean"}}},
    "telemetryDestination": {"type": "object", "required": ["cidr", "port", "purpose"], "properties": {"cidr": {"$ref": "#/definitions/cidr"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "purpose": {"enum": ["greptime", "quickwit"]}}},
    "telemetryComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded", "kind", "evidenceId", "artifactHash", "startedAt", "endedAt", "windowMinutes", "baselineEvents", "candidateEvents", "lossPermille", "p95LatencyMs", "collectorCpuMillicores", "collectorMemoryMiB", "egressBytesPerHour", "storageBytesPerDay", "estimatedCostMicrosPerDay", "limits"],
      "properties": {
        "recorded": {"type": "boolean"}, "kind": {"enum": ["", "local-deterministic-validation", "production-comparison"]},
        "evidenceId": {"type": "string", "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._/-]{0,255})$"},
        "artifactHash": {"type": "string", "pattern": "^(?:|[a-f0-9]{64})$"},
        "startedAt": {"type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z)$"},
        "endedAt": {"type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}T.+Z)$"},
        "windowMinutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "baselineEvents": {"type": "integer", "minimum": 0}, "candidateEvents": {"type": "integer", "minimum": 0},
        "lossPermille": {"type": "integer", "minimum": -1}, "p95LatencyMs": {"type": "integer", "minimum": -1},
        "collectorCpuMillicores": {"type": "integer", "minimum": -1}, "collectorMemoryMiB": {"type": "integer", "minimum": -1},
        "egressBytesPerHour": {"type": "integer", "minimum": -1}, "storageBytesPerDay": {"type": "integer", "minimum": -1},
        "estimatedCostMicrosPerDay": {"type": "integer", "minimum": -1},
        "limits": {"type": "object", "required": ["maxLossPermille", "maxP95LatencyMs", "maxCollectorCpuMillicores", "maxCollectorMemoryMiB", "maxEgressBytesPerHour", "maxStorageBytesPerDay", "maxEstimatedCostMicrosPerDay"], "additionalProperties": false, "properties": {
          "maxLossPermille": {"type": "integer", "minimum": 0, "maximum": 1000}, "maxP95LatencyMs": {"type": "integer", "minimum": 1},
          "maxCollectorCpuMillicores": {"type": "integer", "minimum": 1}, "maxCollectorMemoryMiB": {"type": "integer", "minimum": 1},
          "maxEgressBytesPerHour": {"type": "integer", "minimum": 1}, "maxStorageBytesPerDay": {"type": "integer", "minimum": 1},
          "maxEstimatedCostMicrosPerDay": {"type": "integer", "minimum": 1}
        }}
      }
    }
  }
}
