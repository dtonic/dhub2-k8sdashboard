{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetry production comparison evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "kind", "startedAt", "endedAt", "windowMinutes", "raw", "artifactHash", "lossPermille", "greptimeTableVisibilityMs", "greptimeAllQueryVisibilityMs", "quickwitVisibilityMs", "endToEndRuntimeMs", "p95LatencyMs", "collectorCpuMillicores", "collectorMemoryMiB", "egressBytesPerHour", "storageBytesPerDay", "estimatedCostMicrosPerDay", "operatorProductionMeasurementsRequired"],
  "properties": {
    "schemaVersion": {"const": 1},
    "environment": {"enum": ["stage", "prod"]},
    "kind": {"const": "production-comparison"},
    "startedAt": {"type": "string", "format": "date-time"},
    "endedAt": {"type": "string", "format": "date-time"},
    "windowMinutes": {"type": "integer", "minimum": 30, "maximum": 10080},
    "artifactHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonScope", "baselineTopology", "candidateTopology", "corpusDigest", "corpusEventDigests", "corpusCount", "baselineEvents", "candidateEvents", "duplicates", "injected503", "permanent503Attempts", "payloadBytes", "quickwitDocuments", "baselineLatenciesMs", "candidateLatenciesMs", "baselineTrialEventCounts", "candidateTrialEventCounts", "baselineTrialP95Ms", "candidateTrialP95Ms", "candidateMeasurementDurationMs", "cpuTrialDurationMs", "baselineCollectorSamples", "candidateCollectorSamples", "baselineCpuMillicores", "baselineMemoryMiB", "cpuDeltaMillicores", "memoryDeltaMiB", "baselineCpuTimeNanos", "candidateCpuTimeNanos", "baselineCpuStatMicros", "candidateCpuStatMicros", "cpuTimeDeltaNanos", "baselineCpuNanosPerEvent", "candidateCpuNanosPerEvent", "storedBytes", "observedStoredEvents", "assumptions"],
      "properties": {
        "comparisonScope": {"const": "production-existing-vs-otel"},
        "baselineTopology": {"const": "existing-production-collector->backend"},
        "candidateTopology": {"const": "otel-agent-cluster-gateway->backend"},
        "corpusDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "corpusEventDigests": {"type": "array", "minItems": 20, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "corpusCount": {"type": "integer", "minimum": 20},
        "baselineEvents": {"type": "integer", "minimum": 1},
        "candidateEvents": {"type": "integer", "minimum": 0},
        "duplicates": {"const": 0},
        "injected503": {"type": "integer", "minimum": 0},
        "permanent503Attempts": {"type": "integer", "minimum": 0},
        "payloadBytes": {"type": "integer", "minimum": 1},
        "quickwitDocuments": {"type": "integer", "minimum": 0},
        "baselineLatenciesMs": {"type": "array", "minItems": 20, "items": {"type": "integer", "minimum": 0}},
        "candidateLatenciesMs": {"type": "array", "minItems": 20, "items": {"type": "integer", "minimum": 0}},
        "baselineTrialEventCounts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "candidateTrialEventCounts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "baselineTrialP95Ms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "candidateTrialP95Ms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "candidateMeasurementDurationMs": {"type": "integer", "minimum": 1},
        "cpuTrialDurationMs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "baselineCollectorSamples": {"type": "array", "minItems": 3},
        "candidateCollectorSamples": {"type": "array", "minItems": 3},
        "baselineCpuMillicores": {"type": "integer", "minimum": 0},
        "baselineMemoryMiB": {"type": "integer", "minimum": 0},
        "cpuDeltaMillicores": {"type": "integer"},
        "memoryDeltaMiB": {"type": "integer"},
        "baselineCpuTimeNanos": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "candidateCpuTimeNanos": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
        "baselineCpuStatMicros": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "candidateCpuStatMicros": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
        "cpuTimeDeltaNanos": {"type": "integer"},
        "baselineCpuNanosPerEvent": {"type": "integer", "minimum": 1},
        "candidateCpuNanosPerEvent": {"type": "integer", "minimum": 1},
        "storedBytes": {"type": "object"},
        "observedStoredEvents": {"type": "integer", "minimum": 1},
        "assumptions": {"type": "object"}
      }
    },
    "lossPermille": {"type": "integer", "minimum": 0, "maximum": 1000},
    "greptimeTableVisibilityMs": {"type": "integer", "minimum": 0},
    "greptimeAllQueryVisibilityMs": {"type": "integer", "minimum": 0},
    "quickwitVisibilityMs": {"type": "integer", "minimum": 0},
    "endToEndRuntimeMs": {"type": "integer", "minimum": 0},
    "p95LatencyMs": {"type": "integer", "minimum": 0},
    "collectorCpuMillicores": {"type": "integer", "minimum": 0},
    "collectorMemoryMiB": {"type": "integer", "minimum": 0},
    "egressBytesPerHour": {"type": "integer", "minimum": 0},
    "storageBytesPerDay": {"type": "integer", "minimum": 0},
    "estimatedCostMicrosPerDay": {"type": "integer", "minimum": 0},
    "operatorProductionMeasurementsRequired": {"const": false}
  }
}
