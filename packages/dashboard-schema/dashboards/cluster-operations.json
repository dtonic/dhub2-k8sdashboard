{
  "schemaVersion": 1,
  "id": "cluster-operations",
  "title": "Cluster Operations",
  "description": "Kubernetes cluster health and resource signals from the existing overview aggregate.",
  "variables": [
    { "id": "scope", "label": "Scope", "kind": "scope" },
    { "id": "range", "label": "Time range", "kind": "range" }
  ],
  "widgets": [
    { "id": "nodes-ready", "title": "Nodes Ready", "type": "Stat", "binding": "nodes.ready", "layout": { "x": 0, "y": 0, "w": 3, "h": 2 } },
    { "id": "pods-running", "title": "Pods Running", "type": "Gauge", "binding": "pods.runningPercent", "layout": { "x": 3, "y": 0, "w": 3, "h": 2 } },
    { "id": "cpu", "title": "CPU Usage", "type": "TimeSeries", "binding": "trends", "queryRefs": ["metrics.cpu.used", "metrics.cpu.requested"], "layout": { "x": 0, "y": 2, "w": 6, "h": 4 } },
    { "id": "memory", "title": "Memory Usage", "type": "TimeSeries", "binding": "trends", "queryRefs": ["metrics.memory.used", "metrics.memory.requested"], "layout": { "x": 6, "y": 2, "w": 6, "h": 4 } },
    { "id": "unhealthy", "title": "Unhealthy Workloads", "type": "Table", "binding": "unhealthy", "options": { "maxRows": 5000 }, "layout": { "x": 0, "y": 6, "w": 7, "h": 5 } },
    { "id": "events", "title": "Recent Events", "type": "EventTimeline", "binding": "events", "options": { "maxRows": 200 }, "layout": { "x": 7, "y": 6, "w": 5, "h": 5 } }
  ]
}
